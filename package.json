{
  "name": "@kud/jira-cli",
  "version": "0.2.1",
  "type": "module",
  "description": "Jira on the command line — read issues, comments and attachments as plain text",
  "keywords": [
    "jira",
    "cli",
    "atlassian",
    "attachments",
    "jql"
  ],
  "license": "MIT",
  "author": "Erwann Mest <m@kud.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/jira-cli.git"
  },
  "homepage": "https://github.com/kud/jira-cli#readme",
  "bugs": "https://github.com/kud/jira-cli/issues",
  "bin": {
    "jira": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kud/ink-markdown": "0.1.1",
    "@kud/ink-ui": "0.14.1",
    "@kud/jira": "0.2.0",
    "commander": "14.0.1",
    "ink": "7.0.1",
    "react": "19.2.5"
  },
  "devDependencies": {
    "@kud/cli-testing": "0.1.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "ink-testing-library": "4.0.0",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
