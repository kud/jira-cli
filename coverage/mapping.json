{
  "$comment": "Hand-maintained. Every operation in coverage/spec-*.json resolves to exactly one status: an entry under operations wins, then a deprecated flag in the spec (implies wontDo: deprecated), then the tag default. Regenerate docs/coverage.md with npm run coverage.",
  "reasons": {
    "admin-only": {
      "label": "Admin only",
      "why": "needs the Administer Jira global permission",
      "fallback": "ask a Jira admin (the refusal message drafts the request)"
    },
    "app-only": {
      "label": "App only",
      "why": "callable by Connect or Forge apps, or OAuth integrations",
      "fallback": "not reachable with an API token"
    },
    "deprecated": {
      "label": "Deprecated",
      "why": "marked deprecated in the spec",
      "fallback": "use the replacement Atlassian names in the reference"
    },
    "premium-only": {
      "label": "Premium only",
      "why": "Jira Premium (Plans) features",
      "fallback": "open the plan in the web UI"
    },
    "other": {
      "label": "Other",
      "why": "see the note on the row",
      "fallback": "see the note on the row"
    }
  },
